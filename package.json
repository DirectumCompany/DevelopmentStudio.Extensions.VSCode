{
  "name": "development-studio-vscode-extension",
  "displayName": "development-studio-vscode-extension",
  "description": "Development Studio Extension for VS Code",
  "version": "0.0.3",
  "publisher": "sungero",
  "engines": {
    "vscode": "^1.89.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.csproj",
    "onLanguage:csharp"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Sungero",
        "properties": {
          "sungero.resourseLanguageDefault": {
            "type": "string",
            "enumItemLabels": [
              "default (en)",
              "ru"
            ],
            "enum": [
              "en",
              "ru"
            ],
            "description": "Предпочтительный язык ресурсных файлов.",
            "default": "en"
          }
        }
      },
      {
        "title": "Sungero",
        "properties": {
          "sungero.queryTypeDefault": {
            "type": "string",
            "enumItemLabels": [
              "postgres",
              "mssql"
            ],
            "enum": [
              "postgres",
              "mssql"
            ],
            "description": "Предпочтительный тип запроса.",
            "default": "postgres"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "sungero.opensInPeek",
        "title": "Show peek view of the results",
        "category": "Sungero"
      }
    ],
    "keybindings": [
      {
        "command": "sungero.opensInPeek",
        "key": "Ctrl+Alt+R",
        "when": "(editorLangId == csharp) && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack --mode development",
    "watch": "npm run compile && tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "20.x",
    "@types/vscode": "1.89.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "9.19.0",
    "ts-loader": "^9.5.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.23.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  }
}
