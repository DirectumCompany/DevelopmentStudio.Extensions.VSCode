{
  "name": "development-studio-vscode-extension",
  "displayName": "development-studio-vscode-extension",
  "description": "Development Studio Extension for VS Code",
  "version": "0.0.2",
  "publisher": "sungero",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.csproj",
    "onLanguage:csharp"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack --mode development",
    "watch": "npm run compile && tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "9.19.0",
    "ts-loader": "^9.5.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.23.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  }
}
