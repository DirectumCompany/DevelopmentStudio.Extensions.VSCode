{
  "name": "development-studio-vscode-extension",
  "displayName": "development-studio-vscode-extension",
  "description": "Development Studio Extension for VS Code",
  "version": "0.0.2",
  "publisher": "sungero",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "order": 0,
      "title": "Sungero",
      "properties": {
        "sungero.enableAdditionalDefinitionProvider": {
          "type": "boolean",
          "description": "Enable additional DefinitionProvider (requires restart).",
          "order": 0,
          "default": false
        }
      }
    },
    "commands": [
      {
        "command": "development-studio-vscode-extension.GoToOriginalDefinition",
        "title": "Go to Definition",
        "category": "Sungero"
      }
    ],
    "keybindings": [
      {
        "command": "development-studio-vscode-extension.GoToOriginalDefinition",
        "key": "Ctrl+Enter",
        "when": "(editorLangId == csharp) && editorHasDefinitionProvider && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack --mode development",
    "watch": "npm run compile && tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "9.19.0",
    "ts-loader": "^9.5.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.23.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  }
}
