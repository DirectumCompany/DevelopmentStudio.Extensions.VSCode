{
  "name": "development-studio-vscode-extension",
  "displayName": "Development Studio",
  "description": "Development Studio Extension for VS Code",
  "version": "1.0.6",
  "publisher": "sungero",
  "icon": "assets/images/ds-icon.png",
  "engines": {
    "vscode": "^1.89.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.csproj",
    "onLanguage:csharp"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Sungero",
        "properties": {
          "sungero.resourseLanguageDefault": {
            "type": "string",
            "enumItemLabels": [
              "default (en)",
              "ru"
            ],
            "enum": [
              "en",
              "ru"
            ],
            "description": "Предпочтительный язык ресурсных файлов.",
            "default": "en"
          }
        }
      },
      {
        "title": "Sungero",
        "properties": {
          "sungero.queryTypeDefault": {
            "type": "string",
            "enumItemLabels": [
              "postgres",
              "mssql"
            ],
            "enum": [
              "postgres",
              "mssql"
            ],
            "description": "Предпочтительный тип запроса.",
            "default": "postgres"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "sungero.opensInPeek",
        "title": "Показать окно предварительного просмотра",
        "category": "Sungero"
      },
      {
        "command": "sungero.createResourceFromText",
        "title": "Создать ресурс",
        "category": "Sungero"
      }
    ],
    "keybindings": [
      {
        "command": "sungero.opensInPeek",
        "key": "Ctrl+Alt+R",
        "when": "(editorLangId == csharp) && editorTextFocus"
      },
      {
        "command": "sungero.createResourceFromText",
        "key": "Ctrl+Alt+N",
        "when": "(editorLangId == csharp) && editorTextFocus && !editorReadonly"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sungero.createResourceFromText",
          "when": "(editorLangId == csharp) && !editorReadonly"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack --mode development",
    "watch": "npm run compile && tsc -watch -p ./",
    "pretest": "npm run lint",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.1",
    "@types/vscode": "1.89.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "63.2.1",
    "ts-loader": "9.6.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "webpack": "5.109.0",
    "webpack-cli": "7.2.1"
  },
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.0.7",
    "brace-expansion": "5.0.8",
    "minimatch@9": "9.0.9",
    "minimatch@10": "10.2.5"
  }
}