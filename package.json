{
  "name": "development-studio-vscode-extension",
  "displayName": "Development Studio",
  "description": "Development Studio Extension for VS Code",
  "version": "1.0.2",
  "publisher": "sungero",
  "icon": "assets/images/ds-icon.png",
  "engines": {
    "vscode": "^1.89.1",
    "ms-dotnettools.csharp": "2.110.4"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.csproj",
    "onLanguage:csharp"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Sungero",
        "properties": {
          "sungero.resourseLanguageDefault": {
            "type": "string",
            "enumItemLabels": [
              "default (en)",
              "ru"
            ],
            "enum": [
              "en",
              "ru"
            ],
            "description": "Предпочтительный язык ресурсных файлов.",
            "default": "en"
          }
        }
      },
      {
        "title": "Sungero",
        "properties": {
          "sungero.queryTypeDefault": {
            "type": "string",
            "enumItemLabels": [
              "postgres",
              "mssql"
            ],
            "enum": [
              "postgres",
              "mssql"
            ],
            "description": "Предпочтительный тип запроса.",
            "default": "postgres"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "sungero.opensInPeek",
        "title": "Показать окно предварительного просмотра",
        "category": "Sungero"
      }
    ],
    "keybindings": [
      {
        "command": "sungero.opensInPeek",
        "key": "Ctrl+Alt+R",
        "when": "(editorLangId == csharp) && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack --mode development",
    "watch": "npm run compile && tsc -watch -p ./",
    "pretest": "npm run lint",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "20.x",
    "@types/semver": "7.7.1",
    "@types/vscode": "1.89.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.4.1",
    "ts-loader": "9.5.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "webpack": "5.101.0",
    "webpack-cli": "6.0.1"
  }
}