{
  "name": "development-studio-vscode-extension",
  "displayName": "development-studio-vscode-extension",
  "description": "Development Studio Extension for VS Code",
  "version": "0.0.1",
  "publisher": "sungero",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "GoToDefinition"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/vscode": "^1.95.0",
    "@types/node": "20.x",
    "typescript-eslint": "8.23.0",
    "eslint": "9.19.0",
    "typescript": "5.4.5"
  }
}


